---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  dataLang?: string;
  path?: string;
}

const {
  title = 'x1zz — compilers and data infrastructure in Rust',
  description = 'x1zz is a technology studio building compilers, type systems, and data infrastructure in Rust.',
  lang = 'en',
  dataLang = 'en',
  path = '/',
} = Astro.props;

const site = 'https://x1zz.com';
const url = site + path;
const ogImage = site + '/og-main.png';
---

<!doctype html>
<html lang={lang} data-lang={dataLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google" content="notranslate" />
    <meta http-equiv="Content-Language" content={lang === 'en' ? 'en' : 'ko'} />
    <link rel="canonical" href={url} />

    <link rel="icon" type="image/png" href="/favicon-2026.png" />
    <link rel="icon" href="/favicon-2026.ico" />
    <link rel="apple-touch-icon" href="/favicon-2026.png" />

    <!-- social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="x1zz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700;800&family=Noto+Sans+KR:wght@400;500;700&family=Noto+Sans+Mono+CJK+KR:wght@400;500;700&display=swap"
    />

    <script is:inline>
      (function () {
        var html = document.documentElement;
        var touched = false;

        function apply(lang) {
          html.setAttribute('data-lang', lang);
          html.setAttribute('lang', lang === 'kr' ? 'ko' : 'en');
        }
        function remember(lang) {
          try { localStorage.setItem('x1zz-lang', lang); } catch (e) {}
        }

        var saved = null;
        try { saved = localStorage.getItem('x1zz-lang'); } catch (e) {}

        if (saved === 'kr' || saved === 'en') {
          apply(saved);
        } else {
          // Provisional guess from the browser locale — synchronous, so no flash
          // for visitors whose browser is already in Korean.
          var nav = (navigator.language || navigator.userLanguage || '').toLowerCase();
          if (nav.indexOf('ko') === 0) apply('kr');

          // Cloudflare exposes /cdn-cgi/trace on proxied domains; `loc` is the
          // visitor's ISO country from their IP. Use it as the source of truth.
          try {
            fetch('/cdn-cgi/trace', { cache: 'no-store' })
              .then(function (r) { return r.ok ? r.text() : ''; })
              .then(function (text) {
                if (touched) return;
                var m = /^loc=([A-Z]{2})/m.exec(text || '');
                if (!m) return;
                var lang = m[1] === 'KR' ? 'kr' : 'en';
                apply(lang);
                remember(lang);
              })
              .catch(function () {});
          } catch (e) {}
        }

        document.addEventListener('DOMContentLoaded', function () {
          var btn = document.getElementById('lang-toggle');
          if (!btn) return;
          btn.addEventListener('click', function () {
            touched = true;
            var next = (html.getAttribute('data-lang') || 'en') === 'en' ? 'kr' : 'en';
            apply(next);
            remember(next);
          });
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="bg-canvas text-fg min-h-screen flex flex-col" style="font-family: var(--font-sans);">
    <slot />
  </body>
</html>