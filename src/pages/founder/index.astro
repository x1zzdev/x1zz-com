---
import Layout from '../../layouts/Layout.astro';
import GithubIcon from '../../components/GithubIcon.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';

const xazzPipeline = ['Lexer', 'Parser', 'Type Checker', 'Typed IR', 'Codegen', 'Runtime'];

const xzPipeline = ['Lexer', 'Parser', 'Type Checker', 'Contract Check', 'Intent Verify', 'LLVM'];

const xzCode = `/// Computes the Euclidean distance between two points.
/// @intent  Returns the straight-line distance from a to b.
/// @ensures result is ok implies result.value >= 0.0
/// @effects none
func distance(a: Point, b: Point) -> Result[Float, DomainError]
    post result is ok implies result.value >= 0.0
{
    let dx = b.x - a.x
    let dy = b.y - a.y
    ok(sqrt(dx * dx + dy * dy)?)
}`;

const xazzCode = `type AirData = {
  station: string,
  temp:    float,
  pm10:    Option<float>,
}

v dataset = load("air_data.csv") :: AirData
    |> fillNull("pm10", strategy: "mean")

model AirPredictor {
  Dense(64) -> ReLU() -> Dense(1)
}

v trained = dataset
    |> train(AirPredictor, target: "pm10", epochs: 10)`;

const projects = [
  {
    name: 'x1zzLang',
    url: 'https://github.com/x1zzdev/x1zzLang',
    cat: 'Data pipeline DSL',
    catKr: '데이터 파이프라인 DSL',
    en: 'The original data-pipeline DSL that evolved into Xazz. Compiles `.xzz` into Polars LazyFrame plans with a null-safe `Option<T>` type system.',
    kr: 'Xazz로 성장한 최초의 데이터 파이프라인 DSL입니다. `.xzz`를 Polars LazyFrame 계획으로 컴파일하고, 널 안전 `Option<T>` 타입 시스템을 갖췄습니다.',
    stack: 'Rust · Polars · clap',
  },
  {
    name: 'py2xzz',
    url: 'https://github.com/x1zzdev/py2xzz',
    cat: 'Transpiler',
    catKr: '트랜스파일러',
    en: 'A compiler pipeline from Python to `.xzz`: Python 3 is parsed with its own lexer/parser and mapped onto the xazz-core AST, then emitted back as source.',
    kr: 'Python에서 `.xzz`로 가는 컴파일러 파이프라인입니다. 자체 렉서/파서로 Python 3를 읽어 xazz-core AST로 매핑한 뒤 소스로 출력합니다.',
    stack: 'Rust · serde',
  },
  {
    name: 'Visual IDE',
    url: 'https://github.com/x1zzdev/x1zzLang-visual-ide',
    cat: 'Graphical editor',
    catKr: '그래픽 에디터',
    en: 'A React-based editor that turns connected nodes into `.xzz` code in real time and runs it against the backend.',
    kr: '노드를 연결하면 실시간으로 `.xzz` 코드가 생성되어 백엔드에서 실행되는 React 기반 에디터입니다.',
    stack: 'React 18 · Vite · @xyflow/react',
  },
];

const bridges = [
  {
    name: 'next.xz',
    url: 'https://github.com/x1zzdev/next-xz',
    tagEn: 'Next.js × Xz bridge',
    tagKr: 'Next.js × Xz 브리지',
    roleEn: 'Solo project',
    roleKr: '단독 프로젝트',
    en: 'A hybrid framework that keeps Next.js in charge of UI and routing while Xz owns backend logic. A generator emits typed TypeScript bindings from `@export` signatures, Server Actions call the compiled shared library over Bun/Node FFI, and an agent drives the LLM → `xz check-json` → repair loop. The `/___audit` overlay renders contract and effect badges, so a human approves a diff of behavior rather than a multi-file TS diff.',
    kr: 'Next.js가 UI와 라우팅을, Xz가 백엔드 로직을 담당하는 하이브리드 프레임워크입니다. 생성기가 `@export` 시그니처로 타입 안전한 TypeScript 바인딩을 만들고, Server Action은 Bun/Node FFI로 컴파일된 공유 라이브러리를 호출합니다. 에이전트는 LLM → `xz check-json` → 자가 수정 루프를 돌리고, 사람은 `/___audit` 오버레이에서 여러 파일의 TS diff 대신 동작의 diff를 승인합니다.',
    layers: [
      { label: 'Next.js App Router', sub: 'UI · routing · Server Actions' },
      { label: '@xz-lang/bridge', sub: 'generated TS bindings · Bun/Node FFI' },
      { label: 'Xz shared library', sub: 'liborder.so' },
      { label: 'Xz core (.xz)', sub: 'LLVM 17 · contracts' },
    ],
    boundary: { after: 1, label: 'C ABI' },
    stack: 'TypeScript · Bun · Next.js',
    accent: 'accent',
  },
  {
    name: 'rails.xz',
    url: 'https://github.com/imrubydev/rails-xz',
    tagEn: 'Rails × Xz toolkit',
    tagKr: 'Rails × Xz 툴킷',
    roleEn: 'With imrubydev',
    roleKr: 'imrubydev와 공동',
    en: 'A set of gems plus a mountable Engine — a toolkit on top of Rails, not a fork of it. Rails keeps ActiveRecord, Hotwire, and developer experience; Xz owns the logic that must be fast, isolated, and verifiable, loaded through Ruby FFI. The Engine renders the `/xz_audit` dashboard for human approval. I own the bridge and agent; imrubydev owns the Engine and DX.',
    kr: 'gem 모음과 마운트 가능한 Engine으로 이루어진, Rails를 포크하지 않는 툴킷입니다. Rails는 ActiveRecord와 Hotwire, 개발자 경험을 그대로 유지하고, 빠르고 격리되며 검증 가능해야 하는 로직은 Ruby FFI로 로드되는 Xz가 담당합니다. Engine의 `/xz_audit` 대시보드에서 사람의 승인을 거칩니다. 브리지와 에이전트는 제가, Engine과 DX는 imrubydev가 맡습니다.',
    layers: [
      { label: 'Rails', sub: 'controllers · ActiveRecord · Hotwire' },
      { label: 'rails-xz-bridge', sub: 'Ruby bindings · Fiddle / ffi' },
      { label: 'Xz shared library', sub: 'liborder.so' },
      { label: 'Xz core (.xz)', sub: 'LLVM 17 · contracts' },
    ],
    boundary: { after: 1, label: 'C ABI' },
    stack: 'Ruby · Rails',
    accent: 'accent2',
  },
];

const findings = [
  { label: 'PCAG collapse', labelKr: 'PCAG 붕괴', value: '20.8 → 10.4 → 4.8' },
  { label: 'Power wall', labelKr: '파워 월', value: 'INT4 → INT3 · −54.4%' },
  { label: 'Cross-model', labelKr: '모델 교차 검증', value: '4 models · all INT4→INT3' },
  { label: 'Jevons paradox', labelKr: '제본스 역설', value: 'load grows iff E_d > 1' },
];
---

<Layout
  title="Sewoo Jang — founder of x1zz"
  description="Sewoo Jang — founder of x1zz, building compilers and data infrastructure in Rust. Xazz and Xz, plus next.xz and rails.xz bridges bringing Xz to Next.js and Rails."
  lang="en"
  dataLang="en"
  path="/founder"
>
  <!-- ─── HEADER ─────────────────────────────────────────────── -->
  <header class="w-full px-5 md:px-8 py-4 flex flex-wrap items-center justify-between gap-3 border-b border-line">
    <a href="/" class="text-lg font-bold tracking-tight text-fg" style="font-family: var(--font-mono);">
      x1zz<span class="text-accent">.</span>
    </a>
    <nav class="flex flex-wrap items-center justify-end gap-3 text-sm">
      <a href="/blog" class="text-mut hover:text-fg transition-colors">blog</a>
      <a href="/portfolio" class="text-mut hover:text-fg transition-colors">portfolio</a>
      <a href="/writing" class="text-mut hover:text-fg transition-colors">writing</a>
      <a
        href="https://github.com/x1zzdev/Xazz"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-line2 text-fg px-3 py-1.5 hover:border-accent hover:text-accent transition-colors"
        style="font-family: var(--font-mono); font-size: 0.8rem;"
      >
        <GithubIcon size={15} /> GitHub
      </a>
      <button
        id="lang-toggle"
        aria-label="Toggle language"
        class="btn btn-ghost text-[0.8rem] px-3 py-1 cursor-pointer"
      >
        <span class="lang-en">EN → KR</span>
        <span class="lang-kr">KR → EN</span>
      </button>
    </nav>
  </header>

  <main class="w-full max-w-4xl mx-auto px-5 md:px-8">

    <!-- ─── HERO ─────────────────────────────────────────────── -->
    <section class="py-16 md:py-24">
      <p class="text-sm font-semibold text-accent mb-4" style="font-family: var(--font-mono);">
        <span class="lang-en">Sewoo Jang · founder of x1zz</span>
        <span class="lang-kr">장서우 · x1zz 창업자</span>
      </p>
      <p class="text-sm text-dim mb-5 -mt-2" style="font-family: var(--font-mono);">
        <span class="lang-en">high-school student in Korea</span>
        <span class="lang-kr">한국의 고등학생</span>
      </p>

      <h1 class="text-3xl md:text-5xl font-bold leading-tight tracking-tight text-fg mb-5">
        <span class="lang-en">I build compilers — and the bridges that carry them into web frameworks.</span>
        <span class="lang-kr">컴파일러를 만들고, 그것을 웹 프레임워크로 이어주는 브리지도 만듭니다.</span>
      </h1>
      <p class="text-lg text-sub leading-relaxed max-w-2xl">
        <span class="lang-en">Focused on compilers, type systems, and data infrastructure — currently bringing Xz to Next.js and Rails.</span>
        <span class="lang-kr">컴파일러, 타입 시스템, 데이터 인프라에 집중하고 있습니다. 지금은 Xz를 Next.js와 Rails로 이어주는 브리지를 만들고 있습니다.</span>
      </p>

      <div class="mt-7">
        <a
          href="https://github.com/ax1s-x1zz"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-accent text-base px-5 py-2.5"
        >
          <GithubIcon size={18} /> github.com/ax1s-x1zz
        </a>
      </div>
    </section>

    <!-- ─── FEATURED · XAZZ ──────────────────────────────────── -->
    <section class="pb-16 md:pb-20">
      <div class="border-b border-line pb-3 mb-6">
        <span class="seclabel">
          <span class="lang-en">Featured Project</span>
          <span class="lang-kr">대표 프로젝트</span>
        </span>
      </div>

      <div class="border border-line2 bg-panel">
        <div class="p-6 md:p-8">

          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-4">
            <h2 class="text-2xl font-bold text-fg">Xazz</h2>
            <span class="text-sm text-accent font-semibold" style="font-family: var(--font-mono);">
              <span class="lang-en">Rust-based DSL compiler</span>
              <span class="lang-kr">Rust 기반 DSL 컴파일러</span>
            </span>
          </div>

          <p class="text-lg text-sub leading-relaxed mb-4 lang-en">
            A from-scratch compiler for data and ML pipelines. Its own lexer, parser, type checker, Typed IR,
            and codegen lower one `.xzz` script to Polars (data) and Burn (deep learning).
          </p>
          <p class="text-lg text-sub leading-relaxed mb-4 lang-kr">
            데이터·ML 파이프라인용 컴파일러를 처음부터 구현했습니다. 직접 만든 렉서, 파서, 타입 체커, Typed IR,
            코드 생성기를 거쳐 하나의 `.xzz` 스크립트가 Polars(데이터)와 Burn(딥러닝) 코드로 컴파일됩니다.
          </p>

          <!-- pipeline -->
          <div class="flex flex-wrap items-center gap-2 my-6 text-sm" style="font-family: var(--font-mono);">
            {
              xazzPipeline.map((s, i) => (
                <span class="flex items-center gap-2">
                  <span class={i === 5 ? 'border border-accent text-accent px-3 py-1.5 font-semibold' : 'border border-line text-sub px-3 py-1.5'}>
                    {s}
                  </span>
                  {i < xazzPipeline.length - 1 && <span class="text-dim">→</span>}
                </span>
              ))
            }
          </div>
          <p class="text-sm text-mut mb-6" style="font-family: var(--font-mono);">
            <span class="lang-en">// compiled to a typed IR once; the runtime consumes it once</span>
            <span class="lang-kr">// IR로 한 번 컴파일되고, 런타임은 IR을 한 번만 소비</span>
          </p>

          <div class="terminal mb-6">
            <div class="terminal-titlebar">
              <span class="term-dot" style="background:#E06C6C"></span>
              <span class="term-dot" style="background:#E8B35B"></span>
              <span class="term-dot" style="background:#00FFA3"></span>
              <span class="ml-2 text-sm text-sub" style="font-family: var(--font-mono);">demo.xzz</span>
            </div>
            <pre class="px-5 py-4 text-[0.84rem] leading-[1.7] overflow-x-auto" style="font-family: var(--font-mono);">{xazzCode}</pre>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap gap-2">
              <span class="chip">Rust · Polars · Burn · Axum</span>
              <span class="chip">Apache-2.0</span>
            </div>
            <a href="https://github.com/x1zzdev/Xazz" target="_blank" rel="noopener noreferrer" class="btn btn-accent">GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── LANGUAGE LAB · XZ ────────────────────────────────── -->
    <section class="pb-16 md:pb-20">
      <div class="border-b border-line pb-3 mb-6">
        <span class="seclabel" style="color: var(--color-accent2);">
          <span class="lang-en">Language Lab</span>
          <span class="lang-kr">언어 연구</span>
        </span>
      </div>

      <div class="border border-line bg-panel">
        <div class="p-6 md:p-8">

          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-4">
            <h2 class="text-2xl font-bold text-fg">Xz</h2>
            <span class="text-sm font-semibold" style="font-family: var(--font-mono); color: var(--color-accent2);">
              <span class="lang-en">experimental general-purpose language</span>
              <span class="lang-kr">실험적 범용 프로그래밍 언어</span>
            </span>
          </div>

          <p class="text-lg text-sub leading-relaxed mb-4 lang-en">
            Built around one thesis: <strong>AI-written, Human-reviewed.</strong> Xz makes machine-generated code
            readable, verifiable, and trustworthy — every behavior explicit, every contract visible, every failure
            path typed. Its differentiator is intent verification: a documented claim is proven by the compiler,
            trusted by a human, or rejected in strict builds.
          </p>
          <p class="text-lg text-sub leading-relaxed mb-4 lang-kr">
            <strong>AI-written, Human-reviewed</strong>라는 하나의 명제로 설계한 언어입니다. 기계가 생성한 코드를
            읽고, 검증하고, 신뢰할 수 있게 만듭니다 — 모든 동작은 명시적이고, 모든 계약은 보이며, 모든 실패 경로는
            타입으로 드러납니다. 핵심 차별점은 인텐트 검증입니다. 문서화된 주장은 컴파일러가 증명하거나,
            사람이 신뢰하거나, strict 빌드에서 거부됩니다.
          </p>

          <!-- pipeline -->
          <div class="flex flex-wrap items-center gap-2 my-6 text-sm" style="font-family: var(--font-mono);">
            {
              xzPipeline.map((s, i) => (
                <span class="flex items-center gap-2">
                  <span class={i === 5 ? 'border border-accent2 text-accent2 px-3 py-1.5 font-semibold' : 'border border-line text-sub px-3 py-1.5'}>
                    {s}
                  </span>
                  {i < xzPipeline.length - 1 && <span class="text-dim">→</span>}
                </span>
              ))
            }
          </div>
          <p class="text-sm text-mut mb-6" style="font-family: var(--font-mono);">
            <span class="lang-en">// claims are proven, trusted, or rejected — never silently ignored</span>
            <span class="lang-kr">// 주장은 증명·신뢰·거부 중 하나 — 조용히 무시되지 않음</span>
          </p>

          <div class="terminal mb-6">
            <div class="terminal-titlebar">
              <span class="term-dot" style="background:#E06C6C"></span>
              <span class="term-dot" style="background:#E8B35B"></span>
              <span class="term-dot" style="background:#38C8FF"></span>
              <span class="ml-2 text-sm text-sub" style="font-family: var(--font-mono);">contracts.xz</span>
            </div>
            <pre class="px-5 py-4 text-[0.84rem] leading-[1.7] overflow-x-auto" style="font-family: var(--font-mono);">{xzCode}</pre>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap gap-2">
              <span class="chip">Rust · LLVM 17 · inkwell</span>
              <span class="chip">Phases 1–4 · FFI underway</span>
            </div>
            <a href="https://github.com/x1zzdev/Xz" target="_blank" rel="noopener noreferrer" class="btn">GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── BRIDGES ─────────────────────────────────────────── -->
    <section class="pb-16 md:pb-20">
      <div class="border-b border-line pb-3 mb-6 flex flex-wrap items-baseline justify-between gap-3">
        <span class="seclabel" style="color: var(--color-accent2);">
          <span class="lang-en">Bridges</span>
          <span class="lang-kr">브리지</span>
        </span>
        <span class="text-sm text-dim" style="font-family: var(--font-mono);">
          <span class="lang-en">// Xz, carried into web frameworks</span>
          <span class="lang-kr">// Xz를 웹 프레임워크로</span>
        </span>
      </div>

      <div class="space-y-4">
        {
          bridges.map((b) => (
            <div class="border border-line bg-panel p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 mb-2">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="text-lg font-bold text-fg">{b.name}</h3>
                  <span class="text-sm font-semibold" style={`font-family: var(--font-mono); color: var(--color-${b.accent});`}>
                    <span class="lang-en">{b.tagEn}</span>
                    <span class="lang-kr">{b.tagKr}</span>
                  </span>
                </div>
                <span class="chip">
                  <span class="lang-en">{b.roleEn}</span>
                  <span class="lang-kr">{b.roleKr}</span>
                </span>
              </div>

              <p class="text-sub leading-relaxed mb-4 lang-en">{b.en}</p>
              <p class="text-sub leading-relaxed mb-4 lang-kr">{b.kr}</p>

              <div class="mb-4 flex justify-center border border-line bg-canvas p-5">
                <ArchDiagram layers={b.layers} boundary={b.boundary} accent={b.accent} />
              </div>

              <div class="flex flex-wrap items-center justify-between gap-3">
                <span class="chip">{b.stack}</span>
                <a
                  href={b.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={b.accent === 'accent' ? 'btn btn-accent' : 'btn'}
                >
                  GitHub <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ─── PROJECTS ─────────────────────────────────────────── -->
    <section class="pb-16 md:pb-20">
      <div class="border-b border-line pb-3 mb-6">
        <span class="seclabel">
          <span class="lang-en">Projects</span>
          <span class="lang-kr">프로젝트</span>
        </span>
      </div>
      <div class="space-y-4">
        {
          projects.map((p) => (
            <div class="border border-line bg-panel p-6">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                <h3 class="text-lg font-bold text-fg">{p.name}</h3>
                <span class="text-sm text-mut" style="font-family: var(--font-mono);">
                  <span class="lang-en">{p.cat}</span>
                  <span class="lang-kr">{p.catKr}</span>
                </span>
              </div>
              <p class="text-sub leading-relaxed mb-4 lang-en">{p.en}</p>
              <p class="text-sub leading-relaxed mb-4 lang-kr">{p.kr}</p>
              <div class="flex flex-wrap items-center justify-between gap-3">
                <span class="chip">{p.stack}</span>
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-sm text-mut hover:text-accent transition-colors" style="font-family: var(--font-mono);">GitHub ↗</a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ─── RESEARCH ─────────────────────────────────────────── -->
    <section class="pb-16 md:pb-24">
      <div class="border-b border-line pb-3 mb-6">
        <span class="seclabel">
          <span class="lang-en">Research</span>
          <span class="lang-kr">연구</span>
        </span>
      </div>

      <div class="border border-line bg-panel p-6">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-3">
          <h3 class="text-lg font-bold text-fg">LLM-PCAG</h3>
          <span class="text-sm text-mut" style="font-family: var(--font-mono);">
            <span class="lang-en">energy efficiency of LLM quantization</span>
            <span class="lang-kr">LLM 양자화의 에너지 효율</span>
          </span>
        </div>

        <p class="text-sub leading-relaxed mb-5 lang-en">
          Quantifies how much energy weight quantization actually saves. The PCAG metric shows that savings
          collapse faster than accuracy loss, and a power wall at INT4→INT3 was verified through three independent
          paths. The Jevons paradox is proved in closed form.
        </p>
        <p class="text-sub leading-relaxed mb-5 lang-kr">
