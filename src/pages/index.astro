---
import Layout from '../layouts/Layout.astro';
import GithubIcon from '../components/GithubIcon.astro';
import ArchDiagram from '../components/ArchDiagram.astro';

const xazzPipeline = ['Lexer', 'Parser', 'Type Checker', 'Typed IR', 'Codegen', 'Polars'];
const xzPipeline = ['Lexer', 'Parser', 'Type Checker', 'Contract Check', 'Intent Verify', 'LLVM'];

const xazzCode = `type AirData = {
  station: string,
  temp:    float,
  pm10:    Option<float>,
}

v dataset = load("air_data.csv") :: AirData
    |> fillNull("pm10", strategy: "mean")

model AirPredictor {
  Dense(64) -> ReLU() -> Dense(1)
}

v trained = dataset
    |> train(AirPredictor, target: "pm10", epochs: 10)`;

const xzCode = `/// Computes the Euclidean distance between two points.
/// @intent  Returns the straight-line distance from a to b.
/// @ensures result is ok implies result.value >= 0.0
func distance(a: Point, b: Point) -> Result[Float, DomainError]
    post result is ok implies result.value >= 0.0
{
    let dx = b.x - a.x
    let dy = b.y - a.y
    ok(sqrt(dx * dx + dy * dy)?)
}`;

const products = [
  {
    name: 'Xazz',
    url: 'https://github.com/x1zzdev/Xazz',
    tagEn: 'DSL compiler for data & ML pipelines',
    tagKr: '데이터·ML 파이프라인 DSL 컴파일러',
    en: 'A from-scratch compiler with its own lexer, parser, type checker, Typed IR, and codegen — lowering one .xzz script to Polars for data and Burn for deep learning.',
    kr: '직접 만든 렉서, 파서, 타입 체커, Typed IR, 코드 생성기까지 처음부터 구현한 컴파일러입니다. 하나의 .xzz 스크립트가 Polars(데이터)와 Burn(딥러닝) 코드로 컴파일됩니다.',
    pipeline: xazzPipeline,
    code: xazzCode,
    file: 'demo.xzz',
    stack: 'Rust · Polars · Burn · Axum',
    accent: 'accent' as const,
  },
  {
    name: 'Xz',
    url: 'https://github.com/x1zzdev/Xz',
    tagEn: 'AI-written, Human-reviewed language',
    tagKr: 'AI가 쓰고 사람이 검증하는 언어',
    en: 'An experimental language built on one thesis: machine-generated code must be readable and verifiable. Every contract visible, every failure path typed — claims are proven, trusted, or rejected. Never silently ignored.',
    kr: '하나의 명제 위에 세운 실험적 언어입니다. 기계가 생성한 코드는 읽히고 검증될 수 있어야 합니다. 모든 계약은 보이고, 모든 실패 경로는 타입으로 드러나며, 문서화된 주장은 증명되거나 신뢰되거나 거부됩니다 — 조용히 무시되는 일은 없습니다.',
    pipeline: xzPipeline,
    code: xzCode,
    file: 'contracts.xz',
    stack: 'Rust · LLVM 17 · inkwell',
    accent: 'accent2' as const,
  },
];

const bridges = [
  {
    name: 'next.xz',
    url: 'https://github.com/x1zzdev/next-xz',
    tagEn: 'Next.js × Xz',
    tagKr: 'Next.js × Xz',
    en: 'Carries Xz into the App Router. Server Actions call compiled Xz shared libraries over a typed Bun/Node FFI binding, an agent drives the LLM → xz check-json → repair loop, and a /___audit overlay shows a human the contract badges before anything ships.',
    kr: 'Xz를 App Router로 가져옵니다. Server Action은 타입 안전한 Bun/Node FFI 바인딩을 통해 컴파일된 Xz 공유 라이브러리를 호출하고, 에이전트는 LLM → xz check-json → 자가 수정 루프를 돌립니다. 배포 전에는 /___audit 오버레이에서 사람이 계약 배지를 확인합니다.',
    layers: [
      { label: 'Next.js App Router', sub: 'UI · routing · Server Actions' },
      { label: '@xz-lang/bridge', sub: 'generated TS bindings · Bun/Node FFI' },
      { label: 'Xz shared library', sub: 'liborder.so' },
      { label: 'Xz core (.xz)', sub: 'LLVM 17 · contracts' },
    ],
    boundary: { after: 1, label: 'C ABI' },
    stack: 'TypeScript · Bun · Next.js',
    accent: 'accent' as const,
    note: 'Solo project',
    noteKr: '단독 프로젝트',
  },
  {
    name: 'rails.xz',
    url: 'https://github.com/imrubydev/rails-xz',
    tagEn: 'Rails × Xz',
    tagKr: 'Rails × Xz',
    en: 'Brings Xz into Rails as a toolkit, not a fork. A gem loads compiled Xz modules over Ruby FFI, and a mountable Engine renders an /xz_audit dashboard so every generated module gets human approval. Built together with imrubydev.',
    kr: 'Rails를 포크하지 않는 툴킷으로 접근합니다. gem이 Ruby FFI로 컴파일된 Xz 모듈을 로드하고, 마운트 가능한 Engine이 /xz_audit 대시보드를 렌더링해 생성된 모듈마다 사람의 승인을 거칩니다. imrubydev와 함께 만듭니다.',
    layers: [
      { label: 'Rails', sub: 'controllers · ActiveRecord · Hotwire' },
      { label: 'rails-xz-bridge', sub: 'Ruby bindings · Fiddle / ffi' },
      { label: 'Xz shared library', sub: 'liborder.so' },
      { label: 'Xz core (.xz)', sub: 'LLVM 17 · contracts' },
    ],
    boundary: { after: 1, label: 'C ABI' },
    stack: 'Ruby · Rails',
    accent: 'accent2' as const,
    note: 'With imrubydev',
    noteKr: 'imrubydev와 공동',
  },
];

const principles = [
  {
    n: '01',
    en: 'Move errors to compile time',
    kr: '에러를 컴파일 타임으로',
    descEn: 'If a mistake can be caught before the program runs, it must be. Type systems, contract checks, and typed IR exist to make runtime surprises impossible.',
    descKr: '실행되기 전에 잡을 수 있는 실수는 반드시 실행 전에 잡습니다. 타입 시스템, 계약 검사, Typed IR은 모두 런타임에서의 놀람을 원천 차단하기 위해 존재합니다.',
  },
  {
    n: '02',
    en: 'AI-written, human-reviewed',
    kr: 'AI가 쓰고, 사람이 검증한다',
    descEn: 'Machine-generated code should be more trustworthy than handwritten, not less. Documented intent is proven by the compiler or rejected in strict builds.',
    descKr: '기계가 생성한 코드는 손으로 쓴 코드보다 더 신뢰할 수 있어야 합니다. 문서화된 인텐트는 컴파일러가 증명하거나, 사람이 신뢰하거나, strict 빌드에서 거부됩니다.',
  },
  {
    n: '03',
    en: 'One meaning, one place',
    kr: '의미는 한 곳에서',
    descEn: 'A program means what its typed IR says — decided once, consumed once. Backends execute it; nothing re-interprets it.',
    descKr: '프로그램의 의미는 Typed IR이 말하는 것입니다 — 한 번 정해지고, 한 번만 소비됩니다. 백엔드는 그저 실행할 뿐, 다시 해석하지 않습니다.',
  },
];

const findings = [
  { label: 'PCAG collapse', labelKr: 'PCAG 붕괴', value: '20.8 → 10.4 → 4.8' },
  { label: 'Power wall', labelKr: '파워 월', value: 'INT4 → INT3 · −54.4%' },
  { label: 'Cross-model', labelKr: '모델 교차 검증', value: '4 models · all INT4→INT3' },
  { label: 'Jevons paradox', labelKr: '제본스 역설', value: 'load grows iff E_d > 1' },
];
---

<Layout
  title="x1zz — compilers and data infrastructure in Rust"
  description="x1zz is a technology studio building compilers, type systems, and data infrastructure in Rust. Xazz and Xz move errors from runtime to compile time; next.xz and rails.xz carry Xz into Next.js and Rails."
  lang="en"
  dataLang="en"
  path="/"
>
  <!-- ─── HEADER ─────────────────────────────────────────────── -->
  <header class="w-full border-b border-line">
    <div class="max-w-6xl mx-auto px-5 md:px-8 py-4 flex flex-wrap items-center justify-between gap-3">
      <a href="/" class="text-lg font-bold tracking-tight text-fg" style="font-family: var(--font-mono);">
        x1zz<span class="text-accent">.</span>
      </a>
      <nav class="flex flex-wrap items-center justify-end gap-3 md:gap-4 text-sm">
        <a href="#products" class="hidden sm:inline text-mut hover:text-fg transition-colors">products</a>
        <a href="#bridges" class="hidden sm:inline text-mut hover:text-fg transition-colors">bridges</a>
        <a href="#research" class="hidden sm:inline text-mut hover:text-fg transition-colors">research</a>
        <a href="/blog" class="hidden sm:inline text-mut hover:text-fg transition-colors">blog</a>
        <a href="/founder" class="text-mut hover:text-fg transition-colors">founder</a>
        <a
          href="https://github.com/x1zzdev"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-line2 text-fg px-3 py-1.5 hover:border-accent hover:text-accent transition-colors"
          style="font-family: var(--font-mono); font-size: 0.8rem;"
        >
          <GithubIcon size={15} /> GitHub
        </a>
        <button
          id="lang-toggle"
          aria-label="Toggle language"
          class="btn btn-ghost text-[0.8rem] px-3 py-1 cursor-pointer"
        >
          <span class="lang-en">EN → KR</span>
          <span class="lang-kr">KR → EN</span>
        </button>
      </nav>
    </div>
  </header>

  <main class="w-full">

    <!-- ─── HERO · KEY VISUAL (bg-grid band) ─────────────────── -->
    <div class="relative isolate">
      <div class="absolute inset-0 bg-grid -z-10" aria-hidden="true"></div>

      <!-- ─── HERO ─────────────────────────────────────────────── -->
      <section class="max-w-6xl mx-auto px-5 md:px-8 pt-16 md:pt-24 pb-12 md:pb-16">
      <h1 class="text-4xl md:text-[3.25rem] font-bold leading-[1.12] tracking-tight text-fg max-w-3xl mb-6">
        <span class="lang-en">
          Compilers that move errors from runtime to compile time.
        </span>
        <span class="lang-kr">
          에러를 런타임이 아니라 컴파일 타임에 잡는 컴파일러.
        </span>
      </h1>

      <p class="text-lg text-sub leading-relaxed max-w-2xl mb-8">
        <span class="lang-en">
          x1zz builds languages, type systems, and data infrastructure in Rust —
          and the bridges that carry them into Next.js and Rails — so machine-written
          code becomes something you can read, verify, and trust.
        </span>
        <span class="lang-kr">
          x1zz는 Rust로 언어, 타입 시스템, 데이터 인프라를 만들고,
          이를 Next.js와 Rails로 이어주는 브리지도 만듭니다 —
          기계가 쓴 코드를 사람이 읽고, 검증하고, 신뢰할 수 있도록.
        </span>
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <a href="#products" class="btn btn-accent text-base px-5 py-2.5">
          <span class="lang-en">Products</span>
          <span class="lang-kr">제품</span>
        </a>
        <a href="/founder" class="btn text-base px-5 py-2.5">
          <span class="lang-en">Founder</span>
          <span class="lang-kr">창업자</span>
        </a>
      </div>
    </section>

    <!-- ─── KEY VISUAL ───────────────────────────────────────── -->
      <section class="max-w-6xl mx-auto px-5 md:px-8 pb-16 md:pb-24">
        <img
          src="/hero-wave.jpg"
          alt="Oscilloscope trace of a Lissajous signal in x1zz green"
          width="1440"
          height="810"
          loading="eager"
          fetchpriority="high"
          class="keyvisual"
        />
      </section>
    </div>

    <!-- ─── PRODUCTS ─────────────────────────────────────────── -->
    <section id="products" class="max-w-6xl mx-auto px-5 md:px-8 pb-16 md:pb-24 scroll-mt-6">
      <div class="reveal flex flex-wrap items-baseline justify-between gap-3 border-b border-line pb-3 mb-8">
        <span class="seclabel">
          <span class="lang-en">Products</span>
          <span class="lang-kr">제품</span>
        </span>
        <span class="text-sm text-dim" style="font-family: var(--font-mono);">
          <span class="lang-en">// two languages, one philosophy</span>
          <span class="lang-kr">// 두 언어, 하나의 철학</span>
        </span>
      </div>

      <div class="space-y-6">
        {
          products.map((p, i) => (
            <div class="reveal card-hover border border-line bg-panel" style={`--reveal-delay:${i * 0.06}s`}>
              <div class="grid lg:grid-cols-[1fr_1fr]">
                <div class="min-w-0 p-6 md:p-8">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-4">
                    <span class="ch-label">CH{i + 1}</span>
                    <h2 class="text-2xl font-bold text-fg">{p.name}</h2>
                    <span class="text-sm font-semibold" style={`font-family: var(--font-mono); color: var(--color-${p.accent});`}>
                      <span class="lang-en">{p.tagEn}</span>
                      <span class="lang-kr">{p.tagKr}</span>
                    </span>
                  </div>

                  <p class="text-sub leading-relaxed mb-6 lang-en">{p.en}</p>
                  <p class="text-sub leading-relaxed mb-6 lang-kr">{p.kr}</p>

                  <div class="pipeline mb-6">
                    {p.pipeline.map((s, j) => (
                      <>
                        <span class={`pipeline-step ${j === p.pipeline.length - 1 ? 'final' : ''}`}>{s}</span>
                        {j < p.pipeline.length - 1 && <span class="pipeline-arrow">→</span>}
                      </>
                    ))}
                  </div>

                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <span class="chip">{p.stack}</span>
                    <a href={p.url} target="_blank" rel="noopener noreferrer" class={`btn btn-${p.accent}`}>
                      GitHub <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </div>

                <div class="min-w-0 border-t lg:border-t-0 lg:border-l border-line bg-canvas/60 flex items-center">
                  <div class="terminal border-0 w-full">
                    <div class="terminal-titlebar">
                      <span class="term-dot" style="background:#E06C6C"></span>
                      <span class="term-dot" style="background:#E8B35B"></span>
                      <span class="term-dot" style="background:#00FFA3"></span>
                      <span class="ml-2 text-sm text-sub" style="font-family: var(--font-mono);">{p.file}</span>
                    </div>
                    <pre class="px-5 py-4 text-[0.8rem] leading-[1.75] overflow-x-auto h-full" style="font-family: var(--font-mono);">{p.code}</pre>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ─── BRIDGES ──────────────────────────────────────────── -->
    <section id="bridges" class="max-w-6xl mx-auto px-5 md:px-8 pb-16 md:pb-24 scroll-mt-6">
      <div class="reveal flex flex-wrap items-baseline justify-between gap-3 border-b border-line pb-3 mb-8">
        <span class="seclabel" style="color: var(--color-accent2);">
          <span class="lang-en">Bridges</span>
          <span class="lang-kr">브리지</span>
        </span>
        <span class="text-sm text-dim" style="font-family: var(--font-mono);">
          <span class="lang-en">// Xz, carried into web frameworks</span>
          <span class="lang-kr">// Xz를 웹 프레임워크로</span>
        </span>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {
          bridges.map((b, i) => (
            <div class="reveal card-hover border border-line bg-panel p-6 md:p-8 flex flex-col" style={`--reveal-delay:${i * 0.06}s`}>
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-2 mb-4">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="text-2xl font-bold text-fg">{b.name}</h3>
                  <span class="text-sm font-semibold" style={`font-family: var(--font-mono); color: var(--color-${b.accent});`}>
                    <span class="lang-en">{b.tagEn}</span>
                    <span class="lang-kr">{b.tagKr}</span>
                  </span>
                </div>
                <span class="chip">
                  <span class="lang-en">{b.note}</span>
                  <span class="lang-kr">{b.noteKr}</span>
                </span>
              </div>

              <p class="text-sub leading-relaxed mb-6 lang-en">{b.en}</p>
              <p class="text-sub leading-relaxed mb-6 lang-kr">{b.kr}</p>

              <div class="mb-6 flex justify-center border border-line bg-canvas p-5">
                <ArchDiagram layers={b.layers} boundary={b.boundary} accent={b.accent} />
              </div>

              <div class="mt-auto flex flex-wrap items-center justify-between gap-3">
                <span class="chip">{b.stack}</span>
                <a href={b.url} target="_blank" rel="noopener noreferrer" class={`btn btn-${b.accent}`}>
                  GitHub <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ─── PHILOSOPHY ───────────────────────────────────────── -->
    <section class="max-w-6xl mx-auto px-5 md:px-8 pb-16 md:pb-24">
      <div class="reveal border-b border-line pb-3 mb-8">
        <span class="seclabel" style="color: var(--color-accent2);">
          <span class="lang-en">Philosophy</span>
          <span class="lang-kr">철학</span>
        </span>
      </div>

      <div class="grid md:grid-cols-3 gap-4">
        {
          principles.map((pr, i) => (
            <div class="reveal card-hover border border-line bg-panel p-6" style={`--reveal-delay:${i * 0.06}s`}>
              <p class="text-sm mb-3" style={`font-family: var(--font-mono); color: var(--color-${i === 1 ? 'accent2' : 'accent'});`}>{pr.n}</p>
              <h3 class="text-lg font-bold text-fg mb-2">
                <span class="lang-en">{pr.en}</span>
                <span class="lang-kr">{pr.kr}</span>
              </h3>
              <p class="text-sm text-sub leading-relaxed lang-en">{pr.descEn}</p>
              <p class="text-sm text-sub leading-relaxed lang-kr">{pr.descKr}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ─── RESEARCH ─────────────────────────────────────────── -->
    <section id="research" class="max-w-6xl mx-auto px-5 md:px-8 pb-16 md:pb-24 scroll-mt-6">
      <div class="reveal border-b border-line pb-3 mb-8">
        <span class="seclabel">
          <span class="lang-en">Research</span>
          <span class="lang-kr">연구</span>
        </span>
      </div>

      <div class="reveal card-hover border border-line bg-panel p-6 md:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 mb-4">
          <div class="flex flex-wrap items-baseline gap-x-3">
            <h3 class="text-xl font-bold text-fg">LLM-PCAG</h3>
            <span class="text-sm text-mut" style="font-family: var(--font-mono);">
              <span class="lang-en">energy efficiency of LLM quantization</span>
              <span class="lang-kr">LLM 양자화의 에너지 효율</span>
            </span>
          </div>
          <div class="flex items-center gap-3">
            <a href="https://github.com/ax1s-x1zz/llm-pcag-research/blob/main/docs/main_paper.md" target="_blank" rel="noopener noreferrer" class="text-sm text-mut hover:text-accent transition-colors" style="font-family: var(--font-mono);">paper draft ↗</a>
            <a href="https://github.com/ax1s-x1zz/llm-pcag-research" target="_blank" rel="noopener noreferrer" class="btn">Repository <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <p class="text-sub leading-relaxed mb-6 max-w-3xl lang-en">
          Quantifies how much energy weight quantization actually saves. The PCAG metric shows savings collapse
          faster than accuracy loss; a power wall at INT4→INT3 was verified through three independent paths, and the
          Jevons paradox is proved in closed form.
        </p>
        <p class="text-sub leading-relaxed mb-6 max-w-3xl lang-kr">
          가중치 양자화가 에너지를 실제로 얼마나 절감하는지 정량화합니다. PCAG 지표는 절감 효과가 정확도 손실보다
          먼저 무너짐을 보여주고, INT4→INT3 파워 월은 세 가지 독립 경로로 검증했습니다. 제본스 역설은 닫힌 형태로
          증명했습니다.
        </p>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
          {
            findings.map((f) => (
              <div class="border border-line p-4">
                <p class="text-xs text-mut mb-1.5" style="font-family: var(--font-mono);">
                  <span class="lang-en">{f.label}</span>
                  <span class="lang-kr">{f.labelKr}</span>
                </p>
                <p class="text-fg font-semibold" style="font-family: var(--font-mono);">{f.value}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ─── OPEN SOURCE ──────────────────────────────────────── -->
    <section class="max-w-6xl mx-auto px-5 md:px-8 pb-16 md:pb-24">
      <div class="reveal border-b border-line pb-3 mb-8">
        <span class="seclabel">
          <span class="lang-en">Open Source</span>
          <span class="lang-kr">오픈소스</span>
        </span>
      </div>

      <div class="reveal card-hover border border-line bg-panel p-6 md:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-2 mb-4">
          <div class="flex flex-wrap items-baseline gap-x-3">
