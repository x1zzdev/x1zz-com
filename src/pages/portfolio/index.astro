  <script slot="head" is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
  <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />

  <script>
    (function () {
      var btn = document.getElementById('lang-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var html = document.documentElement;
        var current = html.getAttribute('data-lang') || 'en';
        html.setAttribute('data-lang', current === 'en' ? 'kr' : 'en');
        html.setAttribute('lang', current === 'en' ? 'ko' : 'en');
      });
    })();

    // file tree toggle
    (function () {
      document.querySelectorAll('.tree-dir').forEach(function (el) {
        el.addEventListener('click', function () {
          var kids = document.getElementById('dir-' + this.getAttribute('data-dir'));
          if (!kids) return;
          var open = kids.style.display !== 'none';
          kids.style.display = open ? 'none' : 'block';
          this.textContent = (open ? '▸ ' : '▾ ') + this.getAttribute('data-label');
        });
      });
    })();

    // tabs
    var FILE_LABELS = {
      readme: 'README.md',
      'proj-xazz': 'Xazz.md',
      'proj-x1zzlang': 'x1zzLang.md',
      'proj-py2xzz': 'py2xzz.md',
      'proj-llm': 'llm-pcag-research.md',
      'log-security': 'security-guardrail.md',
      'log-ir': 'typed-ir.md',
      'log-deps': 'dependency-isolation.md',
      bench: 'benchmarks.md',
      sandbox: 'demo.xzz',
    };

    (function () {
      var openTabs = ['readme', 'proj-xazz', 'log-security'];
      var activeId = 'readme';
      var bar = document.getElementById('tab-bar');
      var select = document.getElementById('file-select');

      function renderTabs() {
        bar.innerHTML = '';
        openTabs.forEach(function (id) {
          var tab = document.createElement('div');
          tab.className = 'ide-tab' + (id === activeId ? ' active' : '');
          var label = document.createElement('span');
          label.textContent = FILE_LABELS[id];
          tab.appendChild(label);
          var close = document.createElement('span');
          close.textContent = '×';
          close.className = 'ml-1 text-mut hover:text-fg px-0.5';
          close.addEventListener('click', function (e) {
            e.stopPropagation();
            var idx = openTabs.indexOf(id);
            if (idx > -1) openTabs.splice(idx, 1);
            if (activeId === id) activeId = openTabs.length ? openTabs[Math.max(0, idx - 1)] : null;
            renderTabs();
            show(activeId);
          });
          tab.appendChild(close);
          tab.addEventListener('click', function () { activeId = id; renderTabs(); show(id); });
          bar.appendChild(tab);
        });
      }

      function show(id) {
        document.querySelectorAll('.tab-pane').forEach(function (p) { p.classList.add('hidden'); });
        if (id) document.getElementById('pane-' + id).classList.remove('hidden');
        if (select) select.value = id || '';
      }

      function open(id) {
        if (openTabs.indexOf(id) === -1) openTabs.push(id);
        activeId = id;
        renderTabs();
        show(id);
      }

      document.querySelectorAll('.tree-item').forEach(function (el) {
        el.addEventListener('click', function () { open(this.getAttribute('data-file')); });
      });
      if (select) select.addEventListener('change', function () { open(this.value); });

      renderTabs();
      show(activeId);
    })();

    // static syntax highlight
    (function () {
      function esc(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }
      function hl(s, kw) {
        var out = esc(s);
        out = out.replace(/(\/\/.*)/g, '<span style="color:#6C7484">$1</span>');
        out = out.replace(/(&quot;.*?&quot;)/g, '<span style="color:#38C8FF">$1</span>');
        var re = new RegExp('\\b(' + kw.join('|') + ')\\b', 'g');
        out = out.replace(re, '<span style="color:#00FFA3">$1</span>');
        return out;
      }
      var xzzEl = document.querySelector('[data-highlight="xzz"]');
      var rustEl = document.querySelector('[data-highlight="rust"]');
      if (xzzEl) xzzEl.innerHTML = hl(
        'type AirData = {\n  station:  string,\n  temp:     float,\n  pm10:     Option<float>,\n}\n\nv dataset = load("air_data.csv") :: AirData\n    |> fillNull("pm10", strategy: "mean")\n\nmodel AirPredictor {\n  Dense(64) -> ReLU() -> Dense(1)\n}\n\nv trained = dataset\n    |> train(AirPredictor, target: "pm10", epochs: 10)',
        ['type', 'v', 'string', 'float', 'Option', 'model', 'Dense', 'ReLU', 'load', 'fillNull', 'train']
      );
      if (rustEl) rustEl.innerHTML = hl(
        'use polars::prelude::*;\n\nfn main() -> PolarsResult<()> {\n    let mut df = LazyCsvReader::new("air_data.csv")\n        .finish()?\n        .fill_null(FillNullStrategy::Mean)\n        .select([col("station"), col("temp"), col("pm10")]);\n    // ... tensor handoff to Burn, training, predict\n    Ok(())\n}',
        ['use', 'fn', 'let', 'mut', 'Ok', 'PolarsResult']
      );
    })();

    // katex
    (function () {
      function render() {
        var katex = window.katex;
        if (!katex) return;
        var el = document.getElementById('formula-pcag');
        if (el) katex.render('\\text{PCAG}_k = \\dfrac{(P_0-P_k)/P_0}{(A_0-A_k)/A_0}', el, { displayMode: true, throwOnError: false });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', render);
      } else {
        render();
      }
    })();
  </script>
</Layout>