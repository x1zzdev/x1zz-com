---
import '../../styles/global.css';

// Type reference strings in frontmatter to avoid JSX parsing of angle-bracket generics
const optT    = 'Option<T>';
const optFloat = 'Option<float>';

const codeSample = `type AirQuality = {
  station: string,
  pm10:    Option<float>,
}

v data = load("data.csv") :: AirQuality
  |> cast("pm10", "float")
  |> filter(pm10 > 50)
  |> groupBy("station")
  |> mean("pm10")`;

const cliWorkflow = `x1zz new my-project   # scaffold project + sample CSV
cd my-project
x1zz import data.csv  # auto-infer schema → write type block
x1zz run main.xzz     # compile + execute pipeline`;
---

<!DOCTYPE html>
<html lang="en" data-lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="x1zzLang — A Rust-based DSL platform exploring data analysis accessibility. Visual IDE: graphical pipeline editor for .xzz workflows." />
  <title>x1zz // PORTFOLIO</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;700&display=swap" />
</head>
<body class="bg-black text-white min-h-screen flex flex-col" style="font-family: var(--font-sans);">

  <!-- ─── HEADER ───────────────────────────────────────────────────────────── -->
  <header class="w-full border-b border-zinc-800 px-6 py-4 grid grid-cols-3 items-center gap-4">

    <!-- Left: breadcrumb -->
    <div class="flex items-center gap-2">
      <a href="/" class="text-xs tracking-widest text-zinc-500 hover:text-white transition-colors duration-150" style="font-family: var(--font-mono);">x1zz</a>
      <span class="text-zinc-700 text-xs" style="font-family: var(--font-mono);">/</span>
      <span class="text-xs tracking-widest text-white" style="font-family: var(--font-mono);">PORTFOLIO</span>
    </div>

    <!-- Center: slogan -->
    <div class="flex justify-center">
      <span class="text-xs font-semibold tracking-widest text-white uppercase text-center" style="font-family: var(--font-mono);">
        <span class="lang-en">The combination of art and technology</span>
        <span class="lang-kr">예술과 기술의 결합</span>
      </span>
    </div>

    <!-- Right: language toggle -->
    <div class="flex justify-end">
      <button
        id="lang-toggle"
        aria-label="Toggle language"
        class="text-xs font-semibold tracking-widest border border-zinc-600 text-white hover:border-white transition-all duration-150 px-3 py-1 cursor-pointer"
        style="font-family: var(--font-mono);"
      >
        <span class="lang-en">EN → KR</span>
        <span class="lang-kr">KR → EN</span>
      </button>
    </div>

  </header>

  <!-- ─── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="w-full px-6 pt-20 pb-16 flex flex-col items-center">

    <!-- Signature cutout title -->
    <div class="relative w-full max-w-4xl flex items-center justify-center">
      <div class="absolute w-full border-t border-zinc-800"></div>
      <h1 class="relative z-10 bg-black px-8 text-4xl md:text-5xl font-bold tracking-tighter text-white select-none" style="font-family: var(--font-mono);">
        PORTFOLIO
      </h1>
    </div>

    <!-- Version / badge row -->
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      <span class="text-xs border border-zinc-700 px-2 py-0.5 text-zinc-400" style="font-family: var(--font-mono);">v0.2.8</span>
      <span class="text-xs border border-zinc-700 px-2 py-0.5 text-zinc-400" style="font-family: var(--font-mono);">.xzz</span>
      <span class="text-xs border border-zinc-700 px-2 py-0.5 text-zinc-400" style="font-family: var(--font-mono);">Rust + Polars</span>
      <span class="text-xs border border-zinc-700 px-2 py-0.5 text-zinc-400" style="font-family: var(--font-mono);">Apache-2.0</span>
      <span class="text-xs border border-green-900 text-green-500 px-2 py-0.5" style="font-family: var(--font-mono);">3.84× vs pandas</span>
    </div>

    <!-- Intro text -->
    <div class="mt-8 max-w-4xl w-full">
      <p class="text-sm font-medium leading-relaxed text-white lang-en">
        A complete ecosystem combining a Rust-based DSL compiler and a graphical pipeline IDE —
        exploring data analysis accessibility through scripting-level ergonomics and compiled-core performance.
        <span class="text-white font-bold" style="font-family: var(--font-mono);">x1zzLang</span> at the core.
        <span class="text-white font-bold" style="font-family: var(--font-mono);">Visual IDE</span> at the surface.
      </p>
      <p class="text-sm font-medium leading-relaxed text-white lang-kr">
        Rust 기반 DSL 컴파일러와 그래픽 파이프라인 IDE로 구성된 완전한 생태계 —
        스크립트의 편리함과 컴파일러의 성능을 결합한 데이터 분석 DSL 플랫폼.
        <span class="text-white font-bold" style="font-family: var(--font-mono);">x1zzLang</span> 이 코어를,
        <span class="text-white font-bold" style="font-family: var(--font-mono);">Visual IDE</span> 가 인터페이스를 담당합니다.
      </p>
    </div>

  </section>

  <!-- ─── MAIN ──────────────────────────────────────────────────────────────── -->
  <main class="flex-1 w-full max-w-4xl mx-auto px-6 pb-24 space-y-20">

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!-- § 1  CORE ENGINE                                                     -->
    <!-- ════════════════════════════════════════════════════════════════════ -->
    <section>
      <div class="border-b border-zinc-800 pb-3 mb-10">
        <span class="text-xs font-semibold tracking-widest text-white uppercase" style="font-family: var(--font-mono);">
          <span class="lang-en">// 01 — X1ZZLANG · CORE ENGINE</span>
          <span class="lang-kr">// 01 — X1ZZLANG · 코어 엔진</span>
        </span>
      </div>

      <div class="space-y-6">

        <!-- Overview card -->
        <div class="border border-zinc-800 p-6 rounded">
          <h2 class="text-lg font-bold mb-4 text-white" style="font-family: var(--font-mono);">
            <span class="lang-en">A Rust-based DSL for Data Analysis</span>
            <span class="lang-kr">데이터 분석을 위한 Rust 기반 DSL</span>
          </h2>
          <p class="text-sm font-medium leading-relaxed text-white mb-3 lang-en">
            x1zzLang is a domain-specific language that compiles
            <code class="font-bold" style="font-family: var(--font-mono);">.xzz</code> scripts into optimized
            Polars LazyFrame execution plans through a Rust-based compiler pipeline.
            Schema is declared upfront in the type system, and null-safety is enforced at the type level via
            <code class="font-bold" style="font-family: var(--font-mono);">{optT}</code> — no runtime surprises.
          </p>
          <p class="text-sm font-medium leading-relaxed text-white mb-3 lang-kr">
            x1zzLang은
            <code class="font-bold" style="font-family: var(--font-mono);">.xzz</code> 스크립트를 Rust
            컴파일러 파이프라인으로 최적화된 Polars LazyFrame 실행 계획으로 컴파일하는 도메인 특화 언어입니다.
            스키마를 타입 시스템에서 사전에 선언하고,
            <code class="font-bold" style="font-family: var(--font-mono);">{optT}</code>를 통해 타입 수준에서
            널 안전성을 강제합니다 — 런타임 예외 없음.
          </p>
          <div class="border-t border-zinc-800 pt-4 mt-4 flex flex-wrap gap-4 text-xs text-zinc-500" style="font-family: var(--font-mono);">
            <span>Language design</span>
            <span class="text-zinc-700">·</span>
            <span>Compiler engineering</span>
            <span class="text-zinc-700">·</span>
            <span>Type system research</span>
            <span class="text-zinc-700">·</span>
            <span>8th Korea CodeFair 2026</span>
          </div>
        </div>

        <!-- Python vs x1zzLang comparison -->
        <div class="border border-zinc-800 p-6 rounded">
          <h3 class="text-xs font-bold text-white mb-4 uppercase tracking-wider" style="font-family: var(--font-mono);">
            <span class="lang-en">// COMPARISON — PANDAS VS X1ZZLANG</span>
            <span class="lang-kr">// 비교 — PANDAS VS X1ZZLANG</span>
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <!-- Python side -->
            <div class="border border-zinc-800 rounded p-4">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xs font-bold text-zinc-500 uppercase tracking-wider" style="font-family: var(--font-mono);">Python · pandas</span>
              </div>
              <pre class="text-xs leading-relaxed text-zinc-400 overflow-x-auto" style="font-family: var(--font-mono);">import pandas as pd

df = pd.read_csv("data.csv")
df = df[df["pm10"] > 50]
result = df.groupby("station")["pm10"].mean()
print(result)</pre>
              <p class="text-xs text-zinc-600 mt-3 lang-en" style="font-family: var(--font-mono);">// Requires install. Nulls manual. Types at runtime.</p>
              <p class="text-xs text-zinc-600 mt-3 lang-kr" style="font-family: var(--font-mono);">// 설치 필요. 수동 널 처리. 런타임 타입 오류.</p>
            </div>

            <!-- x1zzLang side -->
            <div class="border border-zinc-800 rounded p-4 bg-zinc-950">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xs font-bold text-white uppercase tracking-wider" style="font-family: var(--font-mono);">x1zzLang · .xzz</span>
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-green-500 shrink-0"></span>
              </div>
              <pre class="text-xs leading-relaxed text-zinc-300 overflow-x-auto" style="font-family: var(--font-mono);">{codeSample}</pre>
              <p class="text-xs text-zinc-500 mt-3 lang-en" style="font-family: var(--font-mono);">// No imports. Schema upfront. Null-safe via {optT}.</p>
              <p class="text-xs text-zinc-500 mt-3 lang-kr" style="font-family: var(--font-mono);">// 임포트 없음. 스키마 사전 선언. {optT} 널 안전.</p>
            </div>
          </div>

          <!-- comparison table -->
          <div class="overflow-x-auto">
            <table class="w-full text-xs" style="font-family: var(--font-mono);">
              <thead>
                <tr class="border-b border-zinc-800">
                  <th class="text-left py-2 pr-4 text-zinc-500 font-semibold uppercase tracking-wider"></th>
                  <th class="text-left py-2 pr-4 text-zinc-500 font-semibold uppercase tracking-wider lang-en">Python (pandas)</th>
                  <th class="text-left py-2 pr-4 text-zinc-500 font-semibold uppercase tracking-wider lang-kr">Python (pandas)</th>
                  <th class="text-left py-2 text-white font-semibold uppercase tracking-wider">x1zzLang</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-900">
                <tr>
                  <td class="py-2 pr-4 text-zinc-500 lang-en">Library deps</td>
                  <td class="py-2 pr-4 text-zinc-500 lang-kr">라이브러리 의존성</td>
                  <td class="py-2 pr-4 text-zinc-400 lang-en">pandas, numpy</td>
                  <td class="py-2 pr-4 text-zinc-400 lang-kr">pandas, numpy</td>
                  <td class="py-2 text-green-500">None (built-in)</td>
                </tr>
                <tr>
                  <td class="py-2 pr-4 text-zinc-500 lang-en">Type validation</td>
                  <td class="py-2 pr-4 text-zinc-500 lang-kr">타입 검증</td>
                  <td class="py-2 pr-4 text-zinc-400 lang-en">Runtime</td>
                  <td class="py-2 pr-4 text-zinc-400 lang-kr">런타임</td>
                  <td class="py-2 text-green-500 lang-en">Schema declaration time</td>
                  <td class="py-2 text-green-500 lang-kr">스키마 선언 시점</td>
                </tr>
                <tr>
                  <td class="py-2 pr-4 text-zinc-500 lang-en">Null handling</td>
                  <td class="py-2 pr-4 text-zinc-500 lang-kr">널 처리</td>
                  <td class="py-2 pr-4 text-zinc-400 lang-en">Manual NaN checks</td>
                  <td class="py-2 pr-4 text-zinc-400 lang-kr">수동 NaN 확인</td>
                  <td class="py-2 text-green-500 lang-en">{optT} in type definition</td>
                  <td class="py-2 text-green-500 lang-kr">타입 정의의 {optT}</td>
                </tr>
                <tr>
                  <td class="py-2 pr-4 text-zinc-500 lang-en">Env setup</td>
                  <td class="py-2 pr-4 text-zinc-500 lang-kr">환경 설정</td>
                  <td class="py-2 pr-4 text-zinc-400 lang-en">pip install + venv</td>
                  <td class="py-2 pr-4 text-zinc-400 lang-kr">pip install + venv</td>
                  <td class="py-2 text-green-500 lang-en">Single binary</td>
                  <td class="py-2 text-green-500 lang-kr">단일 바이너리</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- CLI quick start -->
        <div class="border border-zinc-800 p-6 rounded bg-zinc-950">
          <div class="flex items-start gap-3">
            <span class="text-xs font-bold text-white shrink-0 mt-0.5" style="font-family: var(--font-mono);">//</span>
            <div class="w-full">
              <p class="text-xs font-bold text-white mb-3 uppercase tracking-wider" style="font-family: var(--font-mono);">
                <span class="lang-en">QUICK START — CLI WORKFLOW</span>
                <span class="lang-kr">빠른 시작 — CLI 워크플로우</span>
              </p>
              <pre class="text-xs leading-relaxed text-zinc-300 overflow-x-auto" style="font-family: var(--font-mono);">{cliWorkflow}</pre>
              <div class="mt-4 flex flex-wrap gap-3 text-xs text-zinc-600" style="font-family: var(--font-mono);">
                <span class="lang-en">// From scaffold to execution in 3 commands. No virtual environments. No dependency management.</span>
                <span class="lang-kr">// 3개의 명령어로 스캐폴딩부터 실행까지. 가상환경 설정 불필요. 의존성 관리 불필요.</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!-- § 2  ARCHITECTURE                                                    -->
    <!-- ════════════════════════════════════════════════════════════════════ -->
    <section>
      <div class="border-b border-zinc-800 pb-3 mb-10">
        <span class="text-xs font-semibold tracking-widest text-white uppercase" style="font-family: var(--font-mono);">
          <span class="lang-en">// 02 — ARCHITECTURE · DEPENDENCY ISOLATION</span>
          <span class="lang-kr">// 02 — 아키텍처 · 의존성 격리</span>
        </span>
      </div>

      <div class="space-y-6">

        <!-- Crate tree -->
        <div class="border border-zinc-800 p-6 rounded">
          <h3 class="text-xs font-bold text-white mb-4 uppercase tracking-wider" style="font-family: var(--font-mono);">
            <span class="lang-en">// CARGO WORKSPACE STRUCTURE</span>
            <span class="lang-kr">// 카고 워크스페이스 구조</span>
          </h3>
          <pre class="text-xs leading-relaxed text-zinc-400 overflow-x-auto" style="font-family: var(--font-mono);">x1zz (CLI binary)          ~2–5 MB
  │  clap · indicatif · colored · csv · anyhow · encoding_rs
  │  NO Polars  ·  NO Tokio
  │
  ├── x1zz-compiler     Lexer → Parser → Codegen → Emitter
  │   └── x1zz-core     Shared AST / Token / Error (serde only)
  │
  └── [subprocess spawn] ──► x1zz-runner     ~30+ MB
                              └── x1zz-exec  Polars LazyFrame runtime</pre>
          <div class="mt-4 border-t border-zinc-800 pt-4">
            <p class="text-xs text-zinc-500 lang-en" style="font-family: var(--font-mono);">
              // The CLI stays small (~2–5 MB) by never linking Polars. When <code class="text-zinc-400">x1zz run</code> is called,
              it spawns <code class="text-zinc-400">x1zz-runner</code> as a subprocess — carrying all Polars dependencies independently.
              Communication uses only CLI arguments — no IPC protocol.
            </p>
            <p class="text-xs text-zinc-500 lang-kr" style="font-family: var(--font-mono);">
              // CLI는 Polars를 링크하지 않아 ~2–5 MB로 유지됩니다. <code class="text-zinc-400">x1zz run</code> 호출 시 <code class="text-zinc-400">x1zz-runner</code>가
              서브프로세스로 스폰되어 Polars 의존성을 독립적으로 처리합니다. IPC 프로토콜 없이 CLI 인수만으로 통신합니다.
            </p>
          </div>
        </div>

        <!-- Crate responsibilities table -->
        <div class="border border-zinc-800 p-6 rounded">
          <h3 class="text-xs font-bold text-white mb-4 uppercase tracking-wider" style="font-family: var(--font-mono);">
            <span class="lang-en">// CRATE RESPONSIBILITIES</span>
            <span class="lang-kr">// 크레이트 역할</span>
          </h3>
          <div class="overflow-x-auto">
            <table class="w-full text-xs" style="font-family: var(--font-mono);">
              <thead>
                <tr class="border-b border-zinc-800">
                  <th class="text-left py-2 pr-6 text-zinc-500 font-semibold uppercase tracking-wider">Crate</th>
                  <th class="text-left py-2 pr-6 text-zinc-500 font-semibold uppercase tracking-wider lang-en">Role</th>
                  <th class="text-left py-2 pr-6 text-zinc-500 font-semibold uppercase tracking-wider lang-kr">역할</th>
                  <th class="text-left py-2 text-zinc-500 font-semibold uppercase tracking-wider lang-en">Heavy deps</th>
                  <th class="text-left py-2 text-zinc-500 font-semibold uppercase tracking-wider lang-kr">주요 의존성</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-900">
                <tr>
                  <td class="py-2 pr-6 text-white">x1zz (CLI)</td>
                  <td class="py-2 pr-6 text-zinc-400 lang-en">Argument parsing, import, new, emit, check</td>
                  <td class="py-2 pr-6 text-zinc-400 lang-kr">인수 파싱, import, new, emit, check</td>
                  <td class="py-2 text-zinc-600 lang-en">None</td>
                  <td class="py-2 text-zinc-600 lang-kr">없음</td>
                </tr>
                <tr>
                  <td class="py-2 pr-6 text-white">x1zz-core</td>
                  <td class="py-2 pr-6 text-zinc-400 lang-en">Shared AST, Token, Error types</td>
                  <td class="py-2 pr-6 text-zinc-400 lang-kr">공유 AST, 토큰, 에러 타입</td>
                  <td class="py-2 text-zinc-600">serde only</td>
                </tr>
                <tr>
                  <td class="py-2 pr-6 text-white">x1zz-compiler</td>
                  <td class="py-2 pr-6 text-zinc-400 lang-en">Lexer / Parser / Codegen / Emitter</td>
                  <td class="py-2 pr-6 text-zinc-400 lang-kr">렉서 / 파서 / 코드젠 / 이미터</td>
                  <td class="py-2 text-zinc-600 lang-en">None</td>
                  <td class="py-2 text-zinc-600 lang-kr">없음</td>
                </tr>
                <tr>
                  <td class="py-2 pr-6 text-white">x1zz-exec</td>
                  <td class="py-2 pr-6 text-zinc-400 lang-en">Polars execution engine</td>
                  <td class="py-2 pr-6 text-zinc-400 lang-kr">Polars 실행 엔진</td>
                  <td class="py-2 text-white font-bold">Polars, encoding_rs</td>
                </tr>
                <tr>
                  <td class="py-2 pr-6 text-white">x1zz-runner</td>
                  <td class="py-2 pr-6 text-zinc-400 lang-en">Execution binary (spawned by CLI)</td>
                  <td class="py-2 pr-6 text-zinc-400 lang-kr">실행 바이너리 (CLI가 스폰)</td>
                  <td class="py-2 text-zinc-400">via x1zz-exec</td>
                </tr>
                <tr>
                  <td class="py-2 pr-6 text-white">x1zz-server</td>
                  <td class="py-2 pr-6 text-zinc-400 lang-en">REST API server</td>
                  <td class="py-2 pr-6 text-zinc-400 lang-kr">REST API 서버</td>
                  <td class="py-2 text-zinc-400">axum, tokio</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Binary size tradeoff -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="border border-zinc-800 p-5 rounded text-center">
            <code class="text-xs font-bold text-white block mb-2" style="font-family: var(--font-mono);">x1zz (CLI)</code>
            <div class="text-3xl font-bold text-white mb-2" style="font-family: var(--font-mono);">~2–5<span class="text-lg text-zinc-500 ml-1">MB</span></div>
            <p class="text-xs text-zinc-500 lang-en" style="font-family: var(--font-mono);">Compiler, schema inference,<br/>project scaffolding</p>
            <p class="text-xs text-zinc-500 lang-kr" style="font-family: var(--font-mono);">컴파일러, 스키마 추론,<br/>프로젝트 스캐폴딩</p>
          </div>
          <div class="border border-zinc-800 p-5 rounded text-center">
