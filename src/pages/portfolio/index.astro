---
import Layout from '../../layouts/Layout.astro';
import GithubIcon from '../../components/GithubIcon.astro';

const xazzDemo = `type AirData = {
  station:  string,
  temp:     float,
  pm10:     Option<float>,
}

v dataset = load("air_data.csv") :: AirData
    |> fillNull("pm10", strategy: "mean")
    |> select(["station", "temp", "pm10"])

model AirPredictor {
  Dense(64) -> ReLU() -> Dense(1)
}

v trained = dataset
    |> train(AirPredictor, target: "pm10", epochs: 10)`;

const xazzRust = `use polars::prelude::*;

fn main() -> PolarsResult<()> {
    let mut df = LazyCsvReader::new("air_data.csv")
        .finish()?
        .fill_null(FillNullStrategy::Mean)
        .select([col("station"), col("temp"), col("pm10")]);
    // ... tensor handoff to Burn, training, predict
    Ok(())
}`;

const xzDemo = `record Point {
    x: Float
    y: Float
}

/// Computes the Euclidean distance between two points.
/// @intent  Returns the straight-line distance from a to b.
/// @ensures result is ok implies result.value >= 0.0
/// @effects none
func distance(a: Point, b: Point) -> Result[Float, DomainError]
    post result is ok implies result.value >= 0.0
{
    let dx = b.x - a.x
    let dy = b.y - a.y
    ok(sqrt(dx * dx + dy * dy)?)
}`;

const tree = `xazz (CLI binary)                ~2-5 MB
  clap · csv · anyhow · encoding_rs
  NO Polars · NO Tokio

  xazz-core          AST · Token · Error · Typed IR (serde only)
  xazz-compiler      Lexer -> Parser -> Checker -> Typed IR
                     -> Opt -> Emitter + guardrail
  xazz-exec          Polars + Burn runtime (heavy deps isolated)
  xazz-runner        subprocess bridge (std only, timeout)`;

const irOpt = `// xazz-compiler/src/opt.rs
// 1. fold_constants   8 / 2 -> 4.0 (div-by-zero preserved)
// 2. merge_selects    select([a,b]) |> select([a]) -> select([a])
// 3. pushdown_filters filter before select/withColumn when safe`;
